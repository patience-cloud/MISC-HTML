  <a id="vip-float" href="#vip-locations" data-vip-join="floating_button" aria-hidden="true" tabindex="-1" style="position:fixed;left:50%;bottom:20px;z-index:9999;display:inline-block;background:#d84b39;color:#ede6dd;text-decoration:none;text-transform:uppercase;font-weight:800;font-size:17px;letter-spacing:0.08em;line-height:1;padding:16px 30px;border-radius:0;box-shadow:6px 6px 0 #ede6dd;white-space:nowrap;opacity:0;pointer-events:none;transform:translate(-50%,24px);transition:opacity 0.3s ease, transform 0.3s ease;">Join MOZZ VIP</a>
  <script>
  (function () {
    var btn = document.getElementById('vip-float');
    var hero = document.getElementById('vip-hero');
    var join = document.getElementById('vip-join');
    if (!btn || !hero || !join || !('IntersectionObserver' in window)) return;
    var heroVisible = true, joinVisible = false;
    function update() {
      var show = !heroVisible && !joinVisible;
      btn.style.opacity = show ? '1' : '0';
      btn.style.pointerEvents = show ? 'auto' : 'none';
      btn.style.transform = show ? 'translate(-50%,0)' : 'translate(-50%,24px)';
      btn.setAttribute('aria-hidden', show ? 'false' : 'true');
      btn.setAttribute('tabindex', show ? '0' : '-1');
    }
    new IntersectionObserver(function (e) { heroVisible = e[0].isIntersecting; update(); }, { threshold: 0 }).observe(hero);
    new IntersectionObserver(function (e) { joinVisible = e[0].isIntersecting; update(); }, { threshold: 0.2 }).observe(join);
